NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Production only: server-only (no NEXT_PUBLIC_ prefix) origin of the real API,
# used by next.config.mjs to proxy /api/v1/* same-origin through Vercel so the
# auth cookie isn't a cross-site third-party cookie. In production also set
# NEXT_PUBLIC_API_URL=/api/v1 so the browser calls this same origin.
# Leave both unset in local dev.
# API_PROXY_TARGET=https://hirelinkks.duckdns.org
